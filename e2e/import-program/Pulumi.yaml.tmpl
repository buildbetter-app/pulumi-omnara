# run.sh renders this file with the IDs of objects the main program created.
# Pulumi YAML requires literal import IDs, so they can't come from config.
# Each resource repeats the inputs the main program set; `pulumi up` fails
# if an imported resource's inputs differ.
name: omnara-e2e-import
runtime: yaml
plugins:
  providers:
    - name: omnara
      path: @PROVIDER_BIN@

variables:
  me:
    fn::invoke:
      function: omnara:index:getCurrentUser
      arguments: {}

resources:
  shared:
    type: omnara:index:Project
    properties:
      name: e2e-@SUFFIX@-shared
    options:
      import: @SHARED_ID@
  secret:
    type: omnara:index:Secret
    properties:
      name: e2e-@SUFFIX@-llm-key
      owner:
        kind: org
      material:
        kind: generic
        value: sk-e2e-revision-2
      metadata:
        purpose: e2e
        revision: r2
    options:
      import: @SECRET_ID@
      # Secret material is write-only, so an import cannot read it back.
      ignoreChanges:
        - material
  profile:
    type: omnara:index:AgentProfile
    properties:
      projectId: @PROJECT_ID@
      name: e2e-profile-r2
      configId: @CONFIG_ID@
    options:
      import: @PROJECT_ID@/@PROFILE_ID@
  webhook:
    type: omnara:index:EventWebhook
    properties:
      projectId: @PROJECT_ID@
      url: https://example.com/omnara/revision-2
      eventTypes:
        - agent_input
        - model_output
      scope:
        type: project
    options:
      import: @PROJECT_ID@/@WEBHOOK_ID@
  access:
    type: omnara:index:OrgMemberProjectAccess
    properties:
      userId: ${me.user.id}
      projectId: @SHARED_ID@
      role: admin
    options:
      import: @ACCESS_ID@
