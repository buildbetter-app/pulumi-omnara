{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "agentConfig.ts",
        "agentProfile.ts",
        "config/index.ts",
        "config/vars.ts",
        "configuredModel.ts",
        "cronTrigger.ts",
        "eventWebhook.ts",
        "getAgentConfig.ts",
        "getAgentProfile.ts",
        "getCurrentUser.ts",
        "getIntegrationDefinitions.ts",
        "getModelCatalog.ts",
        "getOrganizations.ts",
        "getProjectMachines.ts",
        "getProjectSecrets.ts",
        "getProjectSkills.ts",
        "getProjects.ts",
        "getToolCatalog.ts",
        "index.ts",
        "integration.ts",
        "integrationSubscription.ts",
        "machine.ts",
        "machineDaemonToken.ts",
        "machinePool.ts",
        "memoryStore.ts",
        "modelProviderConfig.ts",
        "orgMemberProjectAccess.ts",
        "project.ts",
        "projectMachineGrant.ts",
        "projectMachinePoolGrant.ts",
        "projectModelGrant.ts",
        "provider.ts",
        "secret.ts",
        "secretGrant.ts",
        "skill.ts",
        "skillGrant.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
